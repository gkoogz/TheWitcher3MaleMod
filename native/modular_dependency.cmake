# Geometry headers and the numerical worker have separate adoption revisions.
# Do not relabel the existing worker/profile when adopting this optional module.
file(READ "${CMAKE_CURRENT_LIST_DIR}/../dependencies/modular.lock.json" modular_lock)
string(JSON modular_revision GET "${modular_lock}" commit)
string(JSON modular_count LENGTH "${modular_lock}" files)
math(EXPR modular_last "${modular_count}-1")
foreach(index RANGE 0 ${modular_last})
  string(JSON path MEMBER "${modular_lock}" files ${index})
  string(JSON expected GET "${modular_lock}" files "${path}")
  file(READ "${MALEMOD_BASE_PATH}/${path}" contents)
  string(REPLACE "\r\n" "\n" contents "${contents}")
  string(SHA256 actual "${contents}")
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${MALEMOD_BASE_PATH}"
    show "${modular_revision}:${path}" OUTPUT_VARIABLE committed RESULT_VARIABLE result)
  string(REPLACE "\r\n" "\n" committed "${committed}")
  string(SHA256 pinned "${committed}")
  if(NOT result EQUAL 0 OR NOT pinned STREQUAL expected)
    message(FATAL_ERROR "Shared modular source differs from its adoption pin: ${path}")
  endif()
  if(NOT actual STREQUAL expected)
    if(NOT MALEMOD_ALLOW_DIRTY_BASE_DIAGNOSTIC)
      message(FATAL_ERROR "Shared modular source differs from its adoption pin: ${path}")
    endif()
    message(WARNING "DIAGNOSTIC ONLY: unadopted modular source ${path} SHA256=${actual}")
  endif()
endforeach()
